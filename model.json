{
  "kind": "camera_photo",
  "version": "0.1.0",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "title": "Camera Photo",
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [],
    "outputs": [
      {
        "id": 1,
        "name": "photo",
        "title": "Photo",
        "emits": [
          "image/path",
          "file/path",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "resolution": "1280x720",
    "camera_facing": "environment",
    "jpeg_quality": 0.92,
    "output_dir": "exports/camera",
    "latest_capture_path": "",
    "latest_capture_mime": "",
    "latest_capture_at": "",
    "capture_source": "browser"
  },
  "runtime": {
    "initial_state": "ready",
    "runtime_executable": true,
    "active_worker": true,
    "generic_source": true,
    "centralized_executor": "generic"
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/block_ui.css"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      },
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/block_ui.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties_mount.js"
      },
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/block_ui.css"
      },
      {
        "kind": "js",
        "path": "assets/js/node_card.js"
      }
    ],
    "mini_node_card": [
      {
        "kind": "css",
        "path": "assets/css/block_ui.css"
      },
      {
        "kind": "css",
        "path": "mini/node_card.css"
      },
      {
        "kind": "js",
        "path": "mini/node_card.js"
      }
    ]
  }
}
