{
  "kind": "camera_photo",
  "title": "Camera Photo",
  "ports": {
    "inputs": [],
    "outputs": [
      {
        "id": 1,
        "name": "photo",
        "title": "Photo",
        "emits": ["image/path", "file/path", "message/*"],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "resolution": "1280x720",
    "camera_facing": "environment",
    "jpeg_quality": 0.92,
    "output_dir": "exports/camera",
    "latest_capture_path": "",
    "latest_capture_mime": "",
    "latest_capture_at": "",
    "capture_source": "browser"
  },
  "runtime": {
    "initial_state": "ready",
    "runtime_executable": true,
    "active_worker": true,
    "generic_source": true,
    "centralized_executor": "generic"
  }
}
